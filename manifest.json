{
  "manifestVersion": 5,
  "id": "com.beatmarker.ppro",
  "name": "Beat Marker",
  "version": "0.2.0",
  "main": "index.html",
  "host": [
    {
      "app": "premierepro",
      "minVersion": "25.2.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "beatMarkerPanel",
      "label": {
        "default": "Beat Marker"
      },
      "minimumSize": { "width": 280, "height": 420 },
      "maximumSize": { "width": 2000, "height": 2000 },
      "preferredDockedSize": { "width": 320, "height": 540 },
      "preferredFloatingSize": { "width": 320, "height": 540 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "fullAccess"
  }
}
